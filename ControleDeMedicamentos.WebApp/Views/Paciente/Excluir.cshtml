@model ExcluirPacienteViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Paciente";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Excluir" asp-route-id="@Model.Id" method="post">
        <div class="alert alert-danger" role="alert">
            Você deseja realmente excluir o registro "@Model.Nome"? Esta ação é irreversível
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-danger" type="submit">Confirmar Exclusão</button>
            <a class="btn btn-outline-secondary" asp-action="Listar">Voltar para a lista</a>
        </div>
    </form>
</div>

