@using ControleDeMedicamentos.WebApp.ModuloPacientes

@model List<Paciente>;

<h2>Controle de Medicamentos</h2>

<hr />
<a href="/">Início</a> / @*Ancora ou link*@
<a href="/Fornecedor/Listar">Fornecedores</a> / @*Ancora ou link*@
<a href="/Medicamento/Listar">Medicamentos</a> / @*Ancora ou link*@
<a href="/Paciente/Listar">Pacientes</a> / @*Ancora ou link*@
<hr />

<h1>Listagem de Pacientes</h1>

<p>
    <a href="Cadastrar">Cadastrar Paciente</a>
</p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Cartão do SUS</th>
            <th>CPF</th>
            <th>Açoes</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Paciente m in Model)
        {
            <tr>
                <td>@m.Id</td>
                <td>@m.Nome</td>
                <td>@m.Telefone</td>
                <td>@m.CartaoSus</td>
                <td>@m.Cpf</td>
                <td>
                    <a href="Editar/@m.Id">Editar</a>
                    <span> | </span>
                    <a href="Excluir/@m.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
