@model List<Paciente>;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Pacientes";
}

<p>
    <a href="Cadastrar">Cadastrar Paciente</a>
</p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Cartão do SUS</th>
            <th>CPF</th>
            <th>Açoes</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Paciente m in Model)
        {
            <tr>
                <td>@m.Id</td>
                <td>@m.Nome</td>
                <td>@m.Telefone</td>
                <td>@m.CartaoSus</td>
                <td>@m.Cpf</td>
                <td>
                    <a href="Editar/@m.Id">Editar</a>
                    <span> | </span>
                    <a href="Excluir/@m.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
