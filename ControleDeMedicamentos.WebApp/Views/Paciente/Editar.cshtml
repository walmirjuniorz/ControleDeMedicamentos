@model EditarPacienteViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Paciente";
}

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">

    <div>
        <label asp-for="Nome"></label>
        <br />
        <input asp-for="Nome" type="text">
    </div>

    <div>
        <label asp-for="Telefone"></label>
        <br />
        <input asp-for="Telefone" type="text">
    </div>

    <div>
        <label asp-for="CartaoSus">Cartão SUS</label>
        <br />
        <input asp-for="CartaoSus" type="text">
    </div>

    <div>
        <label asp-for="Cpf">CPF</label>
        <br />
        <input asp-for="Cpf" type="text">
    </div>

    <br>

    <button type="submit">Confirmar Edição</button>
</form>

<p>
    <a asp-action="Listar">Voltar para a lista</a>
</p>
