@using ControleDeMedicamentos.WebApp.ModuloFornecedores
@using ControleDeMedicamentos.WebApp.ModuloMedicamentos

@model Medicamento;

<h2>Controle de Medicamentos</h2>

<hr />
<a href="/">Início</a> / @*Ancora ou link*@
<a href="/Fornecedor/Listar">Fornecedores</a> / @*Ancora ou link*@
<a href="/Medicamento/Listar">Medicamentos</a> / @*Ancora ou link*@
<hr />

<h1>Exclusão de Medicamento</h1>

<form action="/Medicamento/Excluir/@Model.Id" method="post">

    <p>
        Você deseja realmente excluir o registro "@Model.Nome"? Esta ação é irreversível
    </p>

    <button type="submit">Confirmar</button>
</form>

<p>
    <a href="/Medicamento/Listar">Voltar para a lista</a>
</p>
