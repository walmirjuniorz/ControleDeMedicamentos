@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Paciente";
}

<form action="/Paciente/Cadastrar" method="post">

    <div>
        <label for="nome">Nome</label>
        <input id="nome" name="nome" type="text">
    </div>

    <div>
        <label for="telefone">Telefone</label>
        <input id="telefone" name="telefone" type="text">
    </div>

    <div>
        <label for="cartaosus">Cartão do SUS</label>
        <input id="cartaosus" name="cartaosus" type="text">
    </div>

    <div>
        <label for="cpf">CPF</label>
        <input id="cpf" name="cpf" type="text">
    </div>
    <br>

    <button type="submit">Cadastrar</button>
</form>

<p>
    <a href="/Fornecedor/Listar">Voltar para a lista</a>
</p>
