@model Paciente

<h2>Controle de Medicamentos</h2>

<hr />
<a href="/">Início</a> / @*Ancora ou link*@
<a href="/Fornecedor/Listar">Fornecedores</a> / @*Ancora ou link*@
<a href="/Medicamento/Listar">Medicamentos</a> / @*Ancora ou link*@
<a href="/Funcionario/Listar">Funcionários</a> / @*Ancora ou link*@
<a href="/Paciente/Listar">Pacientes</a> / @*Ancora ou link*@
<hr />

<h1>Edição de Paciente</h1>

<form action="/Paciente/Editar/@Model.Id" method="post">

    <div>
        <label for="nome">Nome</label>
        <input id="nome" name="nome" type="text" value="@Model.Nome">
    </div>

    <div>
        <label for="telefone">Telefone</label>
        <input id="telefone" name="telefone" type="text" value="@Model.Telefone">
    </div>

    <div>
        <label for="cartaoSus">Cartão do SUS</label>
        <input id="cartaoSus" name="cartaoSus" type="text" value="@Model.CartaoSus">
    </div>

    <div>
        <label for="cpf">CPF</label>
        <input id="cpf" name="cpf" type="text" value="@Model.Cpf">
    </div>

    <button type="submit">Confirmar Edição</button>
</form>

<p>
    <a href="/Fornecedor/Listar">Voltar para a lista</a>
</p>
