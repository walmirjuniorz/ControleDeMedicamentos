@model List<Fornecedor>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Fornecedores";
}

<p>
    <a class="btn btn-primary" href="Cadastrar">Cadastrar Fornecedor</a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Náo há nenhum fornecedor registrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">

        @foreach (Fornecedor f in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>@f.Nome</h5>
                            <span class="badge text-bg-secondary">@f.Id</span>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>


    @* <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nome</th>
