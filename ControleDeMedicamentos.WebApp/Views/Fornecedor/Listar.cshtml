@model List<Fornecedor>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Fornecedores";
}

<p>
    <a class="btn btn-primary" href="Cadastrar">Cadastrar Fornecedor</a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Náo há nenhum fornecedor registrado.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Telefone</th>
                <th>CNPJ</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Fornecedor f in Model)
            {
                <tr>
                    <td>@f.Id</td>
                    <td>@f.Nome</td>
                    <td>@f.Telefone</td>
                    <td>@f.Cnpj</td>
                    <td>
                        <a class="btn btn-outline-primary" href="Editar/@f.Id">Editar</a>
                        <a class="btn btn-outline-danger" href="Excluir/@f.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
