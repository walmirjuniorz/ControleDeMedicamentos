@model List<ListarRequisicaoEntradaViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Requisições de Entrada";
}

<p>
    <a class="btn btn-primary" asp-action="Cadastrar"> Cadastrar Requisição de Entrada</a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Nenhuma requisição de entrada cadastrada.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-3">
        @foreach (ListarRequisicaoEntradaViewModel requisicao in Model)
        {
            <div class="col">
                <article class="card h-100">
                    <div class="card-body">
                        <div class="card-header d-flex justify-content-between align-items-center mb-2">
                            <h2 class="h5 mb-0">@requisicao.NomeMedicamento</h2>
                            <span class="badge text-bg-secondary">@requisicao.Id</span>
                        </div>

                        <div class="card-body">
                            <dl class="row mb-2">
                                <dt class="col-sm-4">Funcionário</dt>
                                <dd class="col-sm-8">@requisicao.NomeFuncionario</dd>
                                <dt class="col-sm-4">Quantidade</dt>
                                <dd class=" col-sm-8">@requisicao.Quantidade</dd>
                                <dt class="col-sm-4">Data</dt>
                                <dd class=" col-sm-8">@requisicao.Data.ToShortDateString()</dd>
                            </dl>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
