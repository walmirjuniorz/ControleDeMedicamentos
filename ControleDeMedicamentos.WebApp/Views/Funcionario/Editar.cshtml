@model EditarFuncionarioViewModel


<h2>Controle de Medicamentos</h2>

<hr />
<a asp-controller="Home" asp-action="Index">Início</a> / @*Ancora ou link*@
<a asp-controller="Fornecedor" asp-action="Listar">Fornecedores</a> / @*Ancora ou link*@
<a asp-controller="Medicamento" asp-action="Listar">Medicamentos</a> / @*Ancora ou link*@
<a asp-controller="Funcionario" asp-action="Listar">Funcionários</a> / @*Ancora ou link*@
<a asp-controller="Paciente" asp-action="Listar">Pacientes</a> / @*Ancora ou link*@
<hr />

<h1>Edição de Funcionário</h1>

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">

    <div>
        <label asp-for="Nome"></label>
        <br />
        <input asp-for="Nome" type="text">
    </div>

    <div>
        <label asp-for="Telefone"></label>
        <br />
        <input asp-for="Telefone" type="text">

    </div>

    <div>
        <label asp-for="Cpf">CPF</label>
        <br />
        <input asp-for="Cpf" type="text">

    </div>
    <br>

    <button type="submit">Confirmar Edição</button>
</form>

<p>
    <a asp-action="Listar">Voltar para a lista</a>

</p>
