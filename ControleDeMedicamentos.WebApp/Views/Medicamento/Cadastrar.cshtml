@model CadastrarMedicamentoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Medicamento";
}

<form asp-action="Cadastrar" method="post">

    <div>
        <label asp-for="Nome">Nome</label>
        <br />
        <input asp-for="Nome" type="text">
    </div>

    <div>
        <label asp-for="Descricao">Descrição</label>
        <br />
        <textarea asp-for="Descricao"></textarea>
    </div>

    <div>
        <label asp-for="Fornecedor">Fornecedor</label>
        <br />
        <select asp-for="Fornecedor">
            @foreach (Fornecedor f in ViewBag.Fornecedores)
            {
                <option value="@f.Id">@f.Nome</option>
            }
        </select>
    </div>
    <br>

    <button type="submit">Cadastrar</button>
</form>

<p>
    <a asp-action="Listar">Voltar para a lista</a>
</p>
