@model Paciente

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Paciente";
}

<form action="/Paciente/Excluir/@Model.Id" method="post">

    <p>
        Você deseja realmente excluir o registro "@Model.Nome"? Esta ação é irreversível
    </p>

    <button type="submit">Confirmar Exclusão</button>
</form>

<p>
    <a href="/Fornecedor/Listar">Voltar para a lista</a>
</p>
